
@startuml

entity "usuario" as usuario {
    *id_usuario : INT <<PK>>
    --
    *nombre: VARCHAR(100)
    *password: VARCHAR(100)
}

entity "tip" as tip {
    *id_tip : VARCHAR(50) <<PK>>
    --
    *id_usuario : INT <<FK>>
    *nombre : VARCHAR(100)
    *fecha_publicacion : DATE
    *descripcion : TEXT
}

usuario ||--o{ tip : "ocupa / guarda (1-N)"

@enduml